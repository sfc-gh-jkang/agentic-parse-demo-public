# Copy to config.env (gitignored) and edit. Every value can also be set as an environment variable.
# Snowflake CLI connection name (~/.snowflake/config.toml). Use key-pair or PAT auth for unattended runs.
SNOWFLAKE_CONNECTION=default
# Where the demo is installed. The database is created if missing; the schema, role and warehouse are created.
DEMO_DATABASE=SNOWFLAKE_EXAMPLE
DEMO_SCHEMA=AGENTIC_PARSE_DEMO
DEMO_ROLE=AGENTIC_PARSE_DEMO_RL
DEMO_WAREHOUSE=SFE_AGENTIC_PARSE_DEMO_WH
# Application service name (Snowflake App Runtime).
APP_NAME=AGENTIC_PARSE_DEMO
# Only for headless tests (scripts/app_token.py, web/e2e/*): key-pair user and the app's host.
SNOWFLAKE_ACCOUNT=<your-org>-<your-account>
SNOWFLAKE_USER=<your-user>
SNOWFLAKE_PRIVATE_KEY_PATH=<path-to-rsa_key.p8>
APP_HOST=<app-host>.snowflakecomputing.app
# 1 = an admin already ran sql/01_setup.sql for you; setup.sh skips the ACCOUNTADMIN steps.
SKIP_ADMIN=0
# Snowflake docs tool for the agents (needs the free "Snowflake Documentation" Marketplace database, SNOWFLAKE_DOCUMENTATION).
# auto = use it when present; preflight sets this to 0 in config.env when it is missing. 1 = require it. 0 = install without it.
DOCS_SEARCH=auto
